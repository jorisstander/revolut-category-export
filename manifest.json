{
  "manifest_version": 3,
  "name": "Category Export for Revolut",
  "version": "0.1.0",
  "description": "Export your Revolut transactions to CSV with the category the official export omits. Not affiliated with or endorsed by Revolut.",
  "permissions": ["cookies", "downloads"],
  "host_permissions": ["https://app.revolut.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Category Export for Revolut",
    "default_popup": "extension/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
